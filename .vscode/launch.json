{
  "version": "0.2.0",
  "configurations": [
    {
      // Runs the API on the host against the compose Postgres, so you can set
      // breakpoints in the engine. The pre-launch task stops the containerised
      // backend so port 8000 is free, and stopping the debugger brings it back.
      "name": "backend: uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "preLaunchTask": "free port 8000 for the debugger",
      "postDebugTask": "restore the backend container",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "env": {
        "DATABASE_URL": "postgresql+asyncpg://elenchus:elenchus@localhost:5432/elenchus"
      },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      // The suite creates and drops its own elenchus_test database, so it needs
      // Postgres up but never touches the development data.
      "name": "backend: pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "preLaunchTask": "database up",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "env": {
        "DATABASE_URL": "postgresql+asyncpg://elenchus:elenchus@localhost:5432/elenchus"
      },
      "console": "integratedTerminal"
    }
  ]
}
