# macOS
.DS_Store
__MACOSX/
._*

# Python / FastAPI
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
out/
.pnpm-store/
npm-debug.log*

# Secrets / env. Nothing encrypted lives here any more: the sops bundle was retired
# on 27 Aug 2026, so .env.example is the only env file the repo carries.
.env
.env.*
!.env.example

# Editor / OS
.idea/
# Share the editor config that helps anyone opening the repo; keep personal
# workspace state (and whatever extensions write in) out of it.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.log

# One-off local export artifacts
exports/

# The LLM spend ledger. Append-only telemetry, one line per model call: local to
# whoever ran the surveys, and it grows without bound. LLM_LEDGER_PATH overrides it.
backend/var/

# Local-only compose overlay that publishes Postgres to the host for a GUI client;
# its own header says it is not to be committed.
docker-compose.dbport.yml

# Coverage output. Written by `pytest --cov`, which is not part of `make gate` and is
# run on demand, so these are local artefacts rather than anything the repo carries.
backend/.coverage
backend/coverage.lcov
backend/htmlcov/

# Deploy CLI scratch: project linkage written by `vercel link` / `railway link`,
# machine-local and not shared.
.vercel/
.railway/

# aider's session history and symbol cache.
.aider*
