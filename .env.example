# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Anthropic — required for the LLM features (NL template generation + the
# conversational runner). The scaffold and CRUD run without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres dev credentials are set by docker-compose (viewops/viewops); no need
# to change them for local development.
