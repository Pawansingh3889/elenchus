# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Anthropic — required for the LLM features (NL template generation + the
# conversational runner). The scaffold and CRUD run without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional backup LLM — any OpenAI-compatible endpoint (self-hosted Nemotron/Hermes,
# vLLM, NIM, OpenRouter, Ollama, ...). Used only if the Anthropic primary fails; if the
# Anthropic key above is blank, the backup is used on its own. Leave disabled to ignore.
LLM_BACKUP_ENABLED=false
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=

# Postgres dev credentials are set by docker-compose (viewops/viewops); no need
# to change them for local development.
