# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# The LLM tiers form one ordered failover chain, tried lowest number first. Every tier
# speaks the OpenAI Chat Completions API, so any compatible endpoint fits. A tier is
# reached only when every tier above it fails (transport down, rate limited, out of
# credit, malformed tool call); if they all fail, the request fails loudly.
#
# These are needed only for the LLM features, meaning natural-language template
# generation and the conversational runner. Templates, publishing, runs and results work
# with no tier configured at all.
#
# base_url and model are required once a tier is enabled. api_key may stay blank for a
# local server that does not ask for one.

# Tier 1: OpenAI.
LLM_TIER1_ENABLED=false
LLM_TIER1_BASE_URL=https://api.openai.com/v1
LLM_TIER1_API_KEY=
LLM_TIER1_MODEL=
# Read timeout for this tier. Local CPU models can need >60s on a cold load; raise this
# (e.g. 300) for slow hardware. Unreachable endpoints still fail fast on connect.
LLM_TIER1_TIMEOUT_SECONDS=120
# Opt-in prefix caching for providers that honour `cache_control` (OpenRouter/Anthropic).
# Leave false for OpenAI, which rejects the annotation with a 400.
LLM_TIER1_PROMPT_CACHE=false
# Total context tokens (input + output) this tier's model holds. Unset by default, like
# the prices below: no provider reports its own window, and guessing one would be
# exactly the silent wrong number the "no fallbacks" rule exists to rule out. Set, it
# lets a prompt that would not fit be refused before it is sent, with a clear reason,
# instead of learning that from the provider's own 400 — and the refusal is a plain
# LLMError, so the failover chain tries the next tier rather than stopping here.
# LLM_TIER1_CONTEXT_WINDOW=128000

# Tier 2: Groq.
LLM_TIER2_ENABLED=false
LLM_TIER2_BASE_URL=https://api.groq.com/openai/v1
LLM_TIER2_API_KEY=
LLM_TIER2_MODEL=llama-3.3-70b-versatile
LLM_TIER2_TIMEOUT_SECONDS=120
LLM_TIER2_PROMPT_CACHE=false
# LLM_TIER2_CONTEXT_WINDOW=128000

# Tier 3: OpenRouter.
LLM_TIER3_ENABLED=false
LLM_TIER3_BASE_URL=https://openrouter.ai/api/v1
LLM_TIER3_API_KEY=
LLM_TIER3_MODEL=openrouter/free
LLM_TIER3_TIMEOUT_SECONDS=120
LLM_TIER3_PROMPT_CACHE=false
# LLM_TIER3_CONTEXT_WINDOW=32000

# Tier 4: an empty slot, off by default. A local Ollama used to sit here, shipped as a
# service in docker-compose.yml; it was removed on 8 Aug 2026 because the three hosted
# tiers above cover failover and the model weights cost 1.9 GB to carry. The tier itself
# is kept because any OpenAI-compatible server can take the slot with these four lines
# and no code change: llama.cpp, vLLM, LM Studio, or an Ollama you run yourself.
# LLM_TIER4_ENABLED=true
# LLM_TIER4_BASE_URL=http://localhost:11434/v1
# LLM_TIER4_API_KEY=
# LLM_TIER4_MODEL=
# Generous, because this is the tier most likely to be loading a model from cold.
# LLM_TIER4_TIMEOUT_SECONDS=300
# LLM_TIER4_PROMPT_CACHE=false
# The tier most worth setting this for: whatever fills the empty slot is likeliest to be
# a small local model, and a survey with several long_text answers is exactly the shape
# that can walk past a small window without TRANSCRIPT_WINDOW's message count noticing.
# LLM_TIER4_CONTEXT_WINDOW=8192

# Postgres dev credentials are set by docker-compose (elenchus/elenchus); no need
# to change them for local development.

# ---------------------------------------------------------------- spend ledger
#
# Every model call is appended to a JSONL file, one line each: which tier and model
# served it, how big that model is, the tokens it used, how long it took, and what it
# cost. Load it with pandas.read_json(path, lines=True). The same figures are rolled up
# per run on survey_runs, so the app can show what a conversation cost without reading
# the file.
#
# Path is relative to the backend working directory. Keep it out of the image if you
# want it to survive a rebuild.
# LLM_LEDGER_PATH=var/llm_ledger.jsonl

# Project root directory for relative source file paths in the LLM ledger.
# This makes source file tracking more readable in the admin interface by showing
# relative paths instead of absolute file system paths.
# PROJECT_ROOT=/path/to/your/project

# Model size in billions of parameters, per tier. No provider reports this, and it is
# the axis the measurement turns on: the same token count means one thing from a 3B
# model and another from a 70B one. 0 records as "not stated".
# LLM_TIER1_PARAMS_B=0
# LLM_TIER2_PARAMS_B=70
# LLM_TIER4_PARAMS_B=0

# What each hosted tier charges, in USD per million tokens. Required for every enabled
# tier that is not local: settings refuse to load without both, because an unstated
# price used to record every call as free. Set 0 for a genuinely free model. Input and
# output stay separate because they are priced differently everywhere, and a single
# blended number cannot be re-priced later. Check your provider's current rates; these
# are the listed prices on 13 Sep 2026.
#
# gpt-5.5
# LLM_TIER1_PRICE_IN_PER_MTOK=5.00
# LLM_TIER1_PRICE_OUT_PER_MTOK=30.00
# Optional, for a provider that discounts a repeated prompt prefix. Unset, cached
# input pays the full input rate.
# LLM_TIER1_PRICE_CACHED_IN_PER_MTOK=0.50
# Groq llama-3.3-70b-versatile
# LLM_TIER2_PRICE_IN_PER_MTOK=0.59
# LLM_TIER2_PRICE_OUT_PER_MTOK=0.79
# openrouter/free
# LLM_TIER3_PRICE_IN_PER_MTOK=0
# LLM_TIER3_PRICE_OUT_PER_MTOK=0

# A local tier bills no tokens, so mark it as local and it is priced from wall clock
# instead. Without this a locally served run reports as free, which is the one number
# that is certainly wrong. Every tier now defaults to local=false, so set this on
# whichever tier you point at a model you are running yourself.
# LLM_TIER4_LOCAL=true

# What the machine draws while serving a local tier, and what that energy costs. Both
# are guesses until you measure them: 200W is a mid-range desktop under load, 0.32 is a
# UK domestic tariff in USD. If you want amortised hardware counted, fold it into the
# per-kWh figure rather than trying to model it separately.
# HARDWARE_WATTS=200
# ELECTRICITY_PRICE_PER_KWH=0.32

# Who is an administrator: comma-separated email addresses, matched case-insensitively.
# An admin sees every survey and can read every response, so treat this as a grant.
#
# Configuration rather than a column, so that granting it is not a database edit and an
# admin can still belong to a real department. The trade is that it is easy to change and
# hard to audit, which is why app.access logs every request this is what let through.
# Empty means nobody, which is the right default: the seeded accounts are ordinary
# creators and none of them is privileged until named here.
# ADMIN_EMAILS=you@example.com,ops@example.com

# ---------------------------------------------------------------------------
# Real sign-in (Microsoft and Google)
#
# Leave these empty and the app offers no provider buttons, falling back to the
# development email box, which app.main only mounts when APP_ENV is not "prod".
# So a production deployment with none of this set has no way in at all, which
# is the correct failure rather than a quiet one.
#
# Register the app with the provider first, and set the redirect URI there to
# exactly PUBLIC_BASE_URL + /api/v1/auth/<provider>/callback. A mismatch of even
# a trailing slash is refused by the provider, not by us.
#
# Microsoft: portal.azure.com -> Entra ID -> App registrations -> New. Take the
# Application (client) ID, add a client secret, and set the tenant below to the
# directory id to admit only your organisation. Left empty it means "common",
# which admits any Microsoft account, personal ones included.
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_TENANT=
#
# Google: console.cloud.google.com -> APIs & Services -> Credentials ->
# OAuth client ID -> Web application.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
#
# The key that signs session cookies. No default on purpose: a shared fallback
# would let any deployment mint sessions for any other. Generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# and treat it as a secret. Changing it signs everybody out, which is also how
# you revoke every session at once.
# SESSION_SECRET=
#
# This API's public origin, used to build the redirect URI above. Must be the
# address the browser reaches, not an in-network hostname.
# PUBLIC_BASE_URL=http://localhost:8000

# Database pool, sized for the plant's traffic shape: near-idle all day, then a burst on
# breaks when a shift answers at once. Each live conversation holds one connection across
# its LLM call, so size the ceiling (pool + overflow) to the largest simultaneous group
# you expect, plus a margin for the authors watching. Keep it under Postgres's
# max_connections (default 100).
# DB_POOL_SIZE=10
# DB_POOL_MAX_OVERFLOW=30

# What the interviewer should know about this workplace. Background for the AI that
# conducts a survey, never shown to a respondent and never treated as an instruction:
# it changes how a reply is *read*, not what the engine does.
#
# It exists because the engine is domain-blind and that costs answers. Asked what
# compliance problems they face, a respondent said "temperature" and then "around 6c".
# Whether that is a chill-chain breach or unremarkable depends on the plant, and no
# gate can settle it. The author knows, so the deployment says.
#
# Frozen into each survey at publish, so editing this never changes how answers already
# being given are read. A survey that carries its own description keeps it.
#
# Note what this is not: writing a standard in here does not make anything compliant
# with that standard. It makes the interviewer able to tell a real answer from a
# digression in the vocabulary people actually use on the floor.
# SURVEY_SETTING="Chilled fish processing plant, BRCGS certified, HACCP plan in force.
# Fresh fish is held on ice at 0 to 2 degrees; above that is a chill-chain problem and a
# compliance issue. Batch codes, temperature logs, metal detection and allergen
# segregation are daily routine. Respondents are line leaders and floor staff, many
# working in a second language."

# Embeddings: meaning where words fail (the lens answer map and themes, and optionally a
# second chance in the grounding gate). Price required once enabled.
# LLM_EMBEDDING_ENABLED=true
# LLM_EMBEDDING_BASE_URL=https://api.openai.com/v1
# LLM_EMBEDDING_API_KEY=
# LLM_EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small, listed price on 13 Sep 2026
# LLM_EMBEDDING_PRICE_PER_MTOK=0.02
#
# Semantic grounding: off by default. Measure the threshold before switching it on:
#   cd backend && PYTHONPATH=. uv run python scripts/measure_semantic_grounding.py
# GROUNDING_SEMANTIC_ENABLED=false
# GROUNDING_SIMILARITY_MARGIN=

# ---------------------------------------------------------------- interpretability
#
# Qwen3-0.6B reading captured conduct prompts for the lens pages (hidden layers, attention,
# token relationships, tool-choice confidence). Off by default; conduct never uses it.
# It runs on the host (make interp), so a Mac uses its GPU, and listens beyond localhost so
# the backend container can reach it, which is why the token is required on both sides.
# Generate a token with: openssl rand -hex 24
# INTERP_ENABLED=true
# INTERP_BASE_URL=http://host.docker.internal:8765
# INTERP_TOKEN=
# INTERP_TIMEOUT_SECONDS=900
# INTERP_PARAMS_B=0.6
